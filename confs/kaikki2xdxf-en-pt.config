# dict.properties — Kaikki → XDXF (piped)

kaikki2tab.in=data/kaikki/kaikki.org-all-to-Portuguese.jsonl.gz
kaikki2tab.out=-
kaikki2tab.lang=en
kaikki2tab.embedded-defs=BOTH

tab2xdxf.in=-
tab2xdxf.out=data/out/kaikki-en-pt.xdxf
tab2xdxf.lang=en
tab2xdxf.lang-to=pt
tab2xdxf.no-validate=false
tab2xdxf.name=Wiktionary.org en-pt (Kaikki)
tab2xdxf.desc=Wiktionary.org pt-en (built from Kaikki's source data)
