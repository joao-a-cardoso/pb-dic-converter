# Kaikki → StarDict, full pipeline — linux/chain-kaikki-2-stardict

def version=2026-11                          # Kaikki data version (output file and dictionary name)
def lang=en                                  # headword language
def lang_to=pt                               # definition language
def title=Wiktionary.org ${lang}-${lang_to}  # start of the dictionary name and description
def xdxf=data/out/kaikki-en-pt-${version}.xdxf     # XDXF: written by tab2xdxf, read by xdxf2stardict

kaikki2tab.in=data/kaikki/kaikki.org-all-to-Portuguese.jsonl.gz
kaikki2tab.out=-
kaikki2tab.lang=$lang
kaikki2tab.embedded-defs=BOTH
kaikki2tab.terms-file=java/term-translations_${lang_to}.properties  # labels in the definition language

tab2xdxf.in=-
tab2xdxf.out=$xdxf
tab2xdxf.lang=$lang
tab2xdxf.lang-to=$lang_to
tab2xdxf.validate=true
tab2xdxf.name=$title (Kaikki $version)
tab2xdxf.desc=$title (built from Kaikki's source data)

# StarDict for KOReader (linux/chain-kaikki-2-stardict)
xdxf2stardict.in=$xdxf
xdxf2stardict.out=data/out/kaikki-en-pt-${version}.d
xdxf2stardict.merge-defs=ALWAYS
xdxf2stardict.compress=true
