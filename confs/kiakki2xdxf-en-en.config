# dict.properties — Kaikki → XDXF (piped)

kaikki2tab.in=data/kaikki/en-extract.jsonl.gz
kaikki2tab.out=-
kaikki2tab.lang=en,en
kaikki2tab.embedded-defs=BOTH

tab2xdxf.in=-
